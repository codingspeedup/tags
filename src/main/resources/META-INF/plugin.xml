<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>io.github.codingspeedup.tags</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>T.A.G.S.+</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/codingspeedup/tags">CodingSpeedup</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        <em>Targeted Annotations Generative Syntax</em><br/>
        A productivity framework that integrates structured prompting directly into the development workflow via lightweight code annotations.
        It serves as a lightweight orchestration engine, transforming inline comments into precise, template-driven AI directives for seamless software construction.
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>
    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">

        <toolWindow id="T.A.G.S.+"
                    secondary="true"
                    icon="/META-INF/toolIcon.svg"
                    anchor="bottom"
                    doNotActivateOnStart="true"
                    factoryClass="io.github.codingspeedup.tags.plugin.TagsConsoleWindowFactory"/>

        <postStartupActivity implementation="io.github.codingspeedup.tags.plugin.TagsInitializer"/>

        <applicationConfigurable
                id="io.github.codingspeedup.tags.plugin.TagsSettingsConfigurable"
                instance="io.github.codingspeedup.tags.plugin.TagsSettingsConfigurable"
                key="plugin.label"/>

        <applicationService serviceImplementation="io.github.codingspeedup.tags.plugin.TagsSettingsState"/>

        <toolWindow id="MyToolWindow" factoryClass="io.github.codingspeedup.tags.MyToolWindowFactory"
                    icon="AllIcons.Toolwindows.ToolWindowPalette"/>

    </extensions>

    <actions>
        <group id="TagsGroup" popup="true" icon="/META-INF/toolIcon.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>

            <action id="SendToLLM"
                    class="io.github.codingspeedup.tags.actions.ExecutePromptAction">
            </action>

        </group>
    </actions>
</idea-plugin>