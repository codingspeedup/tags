<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>io.github.codingspeedup.tags</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>TAGS+</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/codingspeedup/tags">CodingSpeedup</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        <em>Targeted Annotations Generative Syntax</em><br/>
        A productivity framework that integrates structured prompting directly into the development workflow via lightweight code annotations.
        It serves as a lightweight orchestration engine, transforming inline comments into precise, template-driven AI directives for seamless software construction.
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.TagsMessageBundle</resource-bundle>
    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">

        <toolWindow id="TAGS+"
                    secondary="true"
                    icon="/META-INF/toolIcon.svg"
                    anchor="bottom"
                    doNotActivateOnStart="true"
                    factoryClass="io.github.codingspeedup.tags.plugin.console.ConsoleWindowFactory"/>

        <postStartupActivity implementation="io.github.codingspeedup.tags.plugin.core.TagsInitializer"/>

        <applicationConfigurable
                id="io.github.codingspeedup.tags.plugin.settings.SettingsConfigurable"
                instance="io.github.codingspeedup.tags.plugin.settings.SettingsConfigurable"
                groupId="tools"
                key="plugin.label"/>

        <applicationService serviceImplementation="io.github.codingspeedup.tags.plugin.settings.SettingsState"/>

        <intentionAction order="first"
                         icon="icons/toolIcon.svg">
            <language/>
            <className>io.github.codingspeedup.tags.intentions.TagsPromptIntention</className>
            <!--            <categoryKey>intention.TagsPromptIntention.text</categoryKey>-->
        </intentionAction>

        <notificationGroup id="TAGS+Group"
                           displayType="BALLOON"
                           key="plugin.label"/>

    </extensions>

    <actions>

        <action id="NewChatMd"
                class="io.github.codingspeedup.tags.actions.NewChatMdAction"
                icon="/META-INF/toolIcon.svg">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>
        <action id="NewPromptLibrary"
                class="io.github.codingspeedup.tags.actions.NewPromptLibraryAction"
                icon="/META-INF/toolIcon.svg">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>
        <action id="NewToolbox"
                class="io.github.codingspeedup.tags.actions.NewToolboxAction"
                icon="/META-INF/toolIcon.svg">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>
        
        <action id="Execute"
                class="io.github.codingspeedup.tags.actions.ProcessAction"
                icon="/META-INF/toolIcon.svg">
            <add-to-group group-id="EditorPopupMenu.Run" anchor="last"/>
        </action>

        <group id="SendToLLMAs"
               class="io.github.codingspeedup.tags.actions.ProcessAsGroup"
               popup="true"
               icon="/META-INF/toolIcon.svg">
            <add-to-group group-id="EditorPopupMenu.Run" anchor="last"/>
        </group>

        <group id="TagsGroupEditorPopupMenu"
               class="io.github.codingspeedup.tags.actions.TagsGroup"
               popup="true"
               icon="/META-INF/toolIcon.svg">
            <add-to-group group-id="EditorPopupMenu.Run" anchor="last"/>

            <action id="InsertTagsSection"
                    class="io.github.codingspeedup.tags.actions.EditInsertSectionAction"/>

            <group id="InsertTagsTemplate"
                   class="io.github.codingspeedup.tags.actions.EditInsertTemplateGroup"
                   popup="true">
                <action id="InsertTagsTemplateBlank"
                        class="io.github.codingspeedup.tags.actions.EditInsertTemplateAction"/>
                <group id="InsertTagsTemplateFromLibrary"
                       popup="true"
                       class="io.github.codingspeedup.tags.actions.EditInsertTemplateFromLibraryGroup"/>
            </group>

            <separator id="TagsGroupInternalSeparator"/>

            <action id="StripTags"
                    class="io.github.codingspeedup.tags.actions.EditStripAction"/>
        </group>

    </actions>

</idea-plugin>